@baseUrl = http://localhost:3001/api/v2

### Read all users
GET {{baseUrl}}/users

### Login user
POST {{baseUrl}}/users/login
Content-Type: application/json

{
    "email" : "neeti5@example.com",
    "password" : "password123"
}

### Logout user
POST {{baseUrl}}/users/logout

### Check token
GET {{baseUrl}}/users/auth



### Create a new user
POST {{baseUrl}}/users
Content-Type: application/json

{
    "username": "Neeti",
    "email": "neeti5@example.com",
    "password": "password123",
    "role": "admin"
}

### Update a user
PUT {{baseUrl}}/users/6a9e1dd5d795a29826a5a5c8
Content-Type: application/json

{
    "username": "Neeti2",
    "email": "neeti2@example.com",
    "password": "password123"
}

### Delete a user
DELETE {{baseUrl}}/users/6a9e1dd5d795a29826a5a5c8


