# ============================================================================
# Go Thailand — Landing environment variables (EXAMPLE ONLY)
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================================

# MongoDB connection string (Atlas or local). NEVER hardcode credentials in code.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/go-thailand?retryWrites=true&w=majority

# JWT secret — generate a long random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Public site URL (used in emails/links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
